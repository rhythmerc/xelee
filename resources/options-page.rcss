/* The Options pages (src/pc/settings_page.cpp: Audio, Graphics): the
   Controls screen's gold line work (fight-controls.rcss), drawn into the
   native Options page's frame (src/melee/mn/mnfight.c) over the running
   menu. No backdrop, title or footer: the page's frame, tab and hint box are
   Melee's. Laid out in px on a 1120x660 screen that the code scales into the
   frame (#screen's transform); rows are placed and sized by the code. */
* { box-sizing: border-box; }
body { width: 100%; height: 100%; margin: 0; font-family: "Noto Sans"; color: #f0f2f5; background-color: #00000000; }
div, span { display: block; }
#screen { position: absolute; left: 0; top: 0; width: 1120px; height: 660px; transform-origin: 0 0; }
#board { position: absolute; left: 0; top: 0; width: 1120px; height: 660px; }

/* A group's heading on its rule, as the stock Sound page's CHANNEL and VOLUME. */
.group { position: absolute; height: 22px; }
.group .rule { position: absolute; left: 0; right: 0; top: 11px; height: 2px; background-color: #f0c22660; }
.group .label { position: absolute; left: 18px; top: 0; padding: 0 10px; font-size: 17px; letter-spacing: 3px; color: #c9b77c; background-color: #0a0906; }

.row { position: absolute; border: 3px #f0c226b0; border-radius: 7px; background-color: #0c0b08e0; box-shadow: #ff961450 0px 0px 8px 1px; }
.row .name { position: absolute; left: 24px; font-size: 26px; font-weight: bold; color: #fff8e0; }
.row.compact .name { font-size: 22px; }
.row.cursor { border-color: #fff4c4; background-color: #1d180af0; box-shadow: #ffb020e0 0px 0px 14px 3px; }
.row.unavailable .name { color: #8d8468; font-weight: normal; }
.row.unavailable { border-color: #f0c22650; box-shadow: none; }

/* A bar of steps and its readout. */
.bar { position: absolute; height: 20px; }
.step { position: absolute; top: 0; height: 20px; border-radius: 2px; background-color: #2a251a; }
.step.on { background-color: #f0c226; box-shadow: #ff961480 0px 0px 5px 1px; }
.row.cursor .step.on { background-color: #fff0a8; box-shadow: #ffb020c0 0px 0px 7px 1px; }
.readout { position: absolute; text-align: right; font-size: 23px; color: #f0e4b8; }

/* A switch's Off and On (the one in force lit), and an action's button. */
.chip { position: absolute; height: 32px; padding-top: 2px; text-align: center; font-size: 21px; border-radius: 5px; color: #6f6852; }
.chip.on, .chip.action { color: #1a1406; font-weight: bold; background-color: #f0c226; box-shadow: #ff961480 0px 0px 6px 1px; }
.row.cursor .chip.on, .row.cursor .chip.action { background-color: #fff0a8; box-shadow: #ffb020c0 0px 0px 8px 2px; }
.row.unavailable .chip.on, .row.unavailable .chip.action { color: #a49a7c; background-color: #3a3320; box-shadow: none; font-weight: normal; }

/* A choice: its value between arrows, as Melee's rules rows. */
.value { position: absolute; text-align: center; font-size: 23px; font-weight: bold; color: #f0e4b8; }
.row.cursor .value { color: #fff8e0; }
.arrow { position: absolute; width: 20px; text-align: center; font-size: 30px; font-weight: bold; color: #8d7a3c; }
.row.cursor .arrow { color: #f0c226; }
.row.unavailable .value { color: #8d8468; font-weight: normal; }

.note { position: absolute; font-size: 15px; letter-spacing: 1px; color: #c9b77c; text-align: right; }

#reset { position: absolute; width: 260px; height: 42px; padding-top: 7px; text-align: center; border: 3px #f0c226a0; border-radius: 7px; background-color: #0c0b08e0; font-size: 18px; color: #f0e4b8; }
#reset.cursor { border-color: #fff4c4; color: #ffffff; background-color: #1d180af0; box-shadow: #ffb020e0 0px 0px 14px 3px; }

/* The restart question (B with a change that waits for a restart), over a
   veil on the rows. */
#ask { display: none; position: absolute; left: 0; top: 0; width: 1120px; height: 660px; background-color: #000000a0; }
#ask.open { display: block; }
#ask-box { position: absolute; border: 3px #fff4c4; border-radius: 9px; background-color: #100e08f8; box-shadow: #ffb020c0 0px 0px 16px 3px; }
#ask-title { position: absolute; left: 0; right: 0; top: 26px; text-align: center; font-size: 30px; font-weight: bold; color: #fff8e0; }
#ask-text { position: absolute; left: 30px; right: 30px; top: 82px; text-align: center; font-size: 22px; color: #f0e4b8; }
.ask { position: absolute; top: 170px; width: 230px; height: 46px; padding-top: 8px; text-align: center; border: 3px #f0c226a0; border-radius: 7px; background-color: #0c0b08e0; font-size: 20px; color: #f0e4b8; }
.ask.cursor { border-color: #fff4c4; color: #1a1406; font-weight: bold; background-color: #fff0a8; box-shadow: #ffb020e0 0px 0px 14px 3px; }
