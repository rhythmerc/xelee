/* XeleeNet's overlay on the stage select (src/pc/xeleenet_menu.cpp SssOverlay,
 * wireframe S1): the list's name top right, the legend bottom centre, laid out
 * at 720 px tall and scaled (mnstagesel.c dims the stages off the list). F5 in
 * the game reloads this file. */
* { box-sizing: border-box; }
body { width: 100%; height: 100%; margin: 0; font-family: "Noto Sans"; color: #f0f0f4; background-color: #00000000; }
div, span { display: block; }
#root { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
/* Boxes of fixed width at the 720 px layout: the pill right-aligned in one,
 * the legend centred in the other (inline blocks size to their content). */
#top { position: absolute; width: 600px; height: 40px; text-align: right; transform-origin: 0 0; }
/* The stage select's own colours throughout: the frame's translucent white,
 * no gold. */
#top .pill { display: inline-block; height: 36px; padding: 0 18px; font-size: 17px; font-weight: bold; line-height: 34px;
             color: #ececf0; border: 2px #ffffff55; border-radius: 18px; background-color: #0c0b16e0; }
#bottom { position: absolute; width: 1120px; height: 46px; text-align: center; transform-origin: 0 0; }
#bottom .keys { display: inline-block; height: 46px; padding: 0 14px; border: 1px #ffffff40; border-radius: 23px;
                background-color: #0c0b16d8; }
#bottom .lg { color: #e6e6ea; }

/* P5: each pick ringed on the grid in its player's colour. */
.ol { position: absolute; } /* a ring texture, xnring:// (xeleenet_menu.cpp) */

/* The picks card, laid out at 720 tall and scaled from its top left: a row
 * per player in the corner under RANDOM. */
/* Quiet beside the grid: the frame's translucent white, no gold (the draw
 * has it). */
#card { position: absolute; transform-origin: 0 0;
        border: 2px #ffffff55; border-radius: 10px; background-color: #0c0b16f4; }
#card .ctitle { position: absolute; left: 14px; right: 14px; top: 9px; height: 18px; font-size: 12px; font-weight: 800;
                letter-spacing: 2px; color: #c4c4cc; line-height: 18px; }
#card .ctimer { position: absolute; right: 0; top: -1px; font-size: 15px; font-weight: 900; letter-spacing: 0;
                color: #ececf0; }
#card .ctimer.low { color: #ff8a7a; }
#card .cdrain { position: absolute; left: 14px; right: 14px; top: 30px; height: 2px; }
#card .cdrain div { height: 2px; background-color: #ffffff80; }
#card .crow { position: absolute; left: 12px; right: 12px; height: 56px; }
#card .cbar { position: absolute; left: 0; top: 6px; width: 6px; height: 44px; border-radius: 2px; }
#card .cbar.pend { opacity: 0.35; } /* not locked in, as the ghosted picture */
/* Four players: a 2x2 grid of pictures, no names. */
#card .ctile { position: absolute; width: 84px; height: 73px; }
#card .ctile .cbar { top: 3px; height: 63px; }
#card .ctile .cpic { left: 12px; top: 0; width: 72px; height: 63px; }
#card .ctile .cthumb.rnd { line-height: 57px; } /* the ? in the middle of the taller picture */
/* Each tile's port, ours bright: the grid has no names. */
#card .ctag { position: absolute; left: 14px; bottom: 12px; height: 15px; padding: 0 4px; border-radius: 3px;
              font-size: 11px; font-weight: 900; line-height: 15px; color: #ffffff; background-color: #000000b0;
              opacity: 0.4; }
#card .ctag.me { opacity: 1; }
#card .cpic { position: absolute; left: 14px; top: 3px; width: 57px; height: 50px; border: 3px #ffffff;
              border-radius: 5px; }
#card .cpic.pend { border: 1px #6f6852; }
#card .cthumb { position: absolute; left: 0; top: 0; width: 100%; height: 100%; border-radius: 3px;
                background-color: #24233a; }
#card .cpic.pend > .cthumb { background-color: #00000000; }
/* The stage our cursor is on, before we pick. */
#card .ghost { position: absolute; left: 0; top: 0; width: 100%; height: 100%; opacity: 0.35; }
#card .cthumb.rnd, #draw .dthumb.rnd { font-weight: 900; text-align: center; color: #ececf0; background-color: #3a2f6a; }
#card .cthumb.rnd { font-size: 24px; line-height: 44px; }
#card .cname { position: absolute; left: 82px; right: 0; top: 8px; height: 18px; font-size: 13px; font-weight: 800;
               line-height: 18px; color: #f0f0f4; overflow: hidden; white-space: nowrap; }
#card .cstage { position: absolute; left: 82px; right: 0; top: 29px; height: 16px; font-size: 12px; line-height: 16px;
                color: #d9d2bb; overflow: hidden; white-space: nowrap; }
#card .cstage.pend { color: #9aa1ad; }

/* The draw: the screen dimmed, the cards side by side in a gold panel (the
 * one bold moment on the page). */
#dim { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #05060f8c; }
#draw { position: absolute; height: 300px; transform-origin: 0 0; border: 2px #f0c226; border-radius: 14px;
        background-color: #0c0b16f8; }
#draw .dtitle { position: absolute; left: 0; right: 0; top: 18px; text-align: center; font-size: 13px; font-weight: 800;
                letter-spacing: 2px; color: #c9b77c; }
#draw .dcard { position: absolute; top: 54px; width: 150px; height: 190px; }
#draw .dcard.out { opacity: 0.28; }
#draw .dthumb { position: absolute; left: 0; top: 0; width: 150px; height: 131px; border-radius: 8px;
                border: 4px #00000000; background-color: #24233a; }
#draw .dthumb.rnd { font-size: 60px; line-height: 123px; color: #f0e4b8; }
#draw .dcard.lit .dthumb { border: 4px #fff4c4; }
#draw .dtag { position: absolute; left: 8px; top: 8px; height: 18px; padding: 0 8px; border-radius: 9px;
              font-size: 10px; font-weight: 800; line-height: 18px; color: #fff8e0; background-color: #000000b0; }
#draw .dstage { position: absolute; left: -10px; right: -10px; top: 138px; text-align: center; font-size: 14px;
                font-weight: 800; color: #fff8e0; white-space: nowrap; }
/* Wide enough for a 15-character name. */
#draw .dwho { position: absolute; left: 3px; width: 144px; top: 162px; height: 20px; border-radius: 10px;
              text-align: center; font-size: 11px; font-weight: 800; line-height: 20px; color: #ffffff;
              overflow: hidden; white-space: nowrap; }
#draw .dcap { position: absolute; left: 0; right: 0; top: 258px; text-align: center; font-size: 16px; font-weight: 900;
              color: #ffe066; }
