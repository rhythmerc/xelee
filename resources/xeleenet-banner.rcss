/* XeleeNet's lobby banner over the CSS (src/pc/xeleenet_menu.cpp, wireframe
 * C1): the brand, the lobby's name and rules, its players and its code, in
 * place of Melee's logo and rules bar. Laid out in px at a 72 px height; the
 * code scales #bar to the window. F5 in the game reloads this file. */
* { box-sizing: border-box; }
body { width: 100%; height: 100%; margin: 0; font-family: "Noto Sans"; color: #fff8e0; background-color: #00000000; }
div, span { display: block; }
#bar { position: absolute; left: 0; top: 0; height: 72px; transform-origin: 0 0; }
.brand { position: absolute; left: 0; top: 4px; width: 234px; height: 64px; padding-left: 28px; font-size: 34px;
         font-weight: 800; letter-spacing: 2px; line-height: 62px; color: #ffffff;
         background-color: #c8321e; border-radius: 32px 0 0 32px; }
/* LAN's brand is shorter: less red, a longer pill. */
#bar.lan .brand { width: 146px; }
#bar.lan .pill { left: 132px; }
/* No italic face ships, so the brand leans by a skew. */
.brand span { display: inline-block; transform: skewX(-12deg); }
.pill { position: absolute; left: 220px; right: 0; top: 4px; height: 64px; border: 3px #f0c226; border-radius: 0 32px 32px 0;
        background-color: #120d08f0; }
.names { position: absolute; left: 30px; top: 6px; width: 60%; }
.bn { font-size: 24px; font-weight: 800; color: #ffffff; }
.br { font-size: 15px; color: #c9b77c; }
.seats { position: absolute; right: 250px; top: 14px; font-size: 24px; font-weight: 800; color: #fff8e0; }
.code { position: absolute; right: 18px; top: 11px; height: 36px; padding: 0 16px; font-size: 19px; font-weight: 800;
        letter-spacing: 2px; line-height: 32px; color: #ffe066; border: 2px #f0c226; border-radius: 18px; }

/* The READY count in the seats' place (gold when everyone is), and the notice
 * slot under the banner: room above and below it (the portraits sit lower in
 * XeleeNet's CSS, mncharsel.c cssXnGridShrink). */
.rpill { position: absolute; right: 250px; top: 13px; height: 32px; padding: 0 14px; font-size: 17px; font-weight: 800;
         letter-spacing: 1px; line-height: 28px; color: #fff8e0; border: 2px #f0c226; border-radius: 16px;
         background-color: #0b0b10; }
.rpill.all { color: #1a1406; background-color: #f0c226; }
.nslot { position: absolute; left: 0; right: 0; top: 91px; text-align: center; }
.notice { display: inline-block; position: relative; height: 34px; padding: 0 22px; font-size: 16px; font-weight: 800;
          letter-spacing: 1px; line-height: 32px; border-radius: 17px; }
.notice.gold { color: #1a1406; background-color: #f0c226; border: 1px #f0c226; }
.notice.warn { color: #f0e4b8; background-color: #0b0b10; border: 1px #f0c226; }
.notice.info { color: #e9e3cf; background-color: #0b0b10; border: 1px #aeaba3; }
.notice.red { color: #ffd0c8; background-color: #2a0e0a; border: 1px #e0392b; }
.notice .drain { position: absolute; left: 0; bottom: 3px; height: 3px; background-color: #1a140680; }

/* The doors' tags (window pixels) and the legend above the doors. */
#doors { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.door { position: absolute; }
.ribbon { position: absolute; left: 3px; right: 3px; text-align: center; font-weight: 900; letter-spacing: 3px;
          color: #1a1406; background-color: #f0c226; }
.tag { position: absolute; left: 10%; right: 10%; text-align: center; font-weight: 800; color: #d6d3cb;
       border: 1px #aeaba399; border-radius: 11px; background-color: #0b0b10d8; }
.tag.warn { color: #ffe066; border-color: #f0c226; background-color: #2a1f08; }
.ctag { position: absolute; padding: 0 7px; font-weight: 800; color: #f0e4b8; border: 1px #f0c226b0;
        border-radius: 9px; background-color: #0b0b10e6; }
.owner { position: absolute; left: 0; right: 0; text-align: center; font-weight: 700; color: #f0e4b8; }
.ctag.new { color: #1a1406; background-color: #f0c226; }
/* The first open seat, when a spare pad of this machine's can take it. */
.door.spare { text-align: center; border: 2px #f0c226; border-radius: 8px; background-color: #0e1230e0; }
.door.spare .st { color: #ffe066; font-weight: 900; }
.door.spare .sl { color: #c9b77c; margin-top: 4px; }
.door.spare .sk { display: inline-block; margin-top: 8px; padding: 1px 10px; border-radius: 8px; color: #26241f;
                  background-color: #aeaba3; font-weight: 900; }
.dash { position: absolute; left: 0; right: 0; top: 0; bottom: 0; border: 3px #fff4c4; border-radius: 8px; }
/* The ring around a hand while its player holds B to leave: dots that fill
 * red as the hold goes on. */
.rdot { position: absolute; background-color: #ffffff40; }
.rdot.on { background-color: #e0392b; }
#clegend { position: absolute; width: 1120px; height: 46px; text-align: center; transform-origin: 0 0; }
#clegend .keys { display: inline-block; height: 46px; padding: 0 14px; border: 1px #f0c22650; border-radius: 23px;
                 background-color: #0c0b08d8; }
