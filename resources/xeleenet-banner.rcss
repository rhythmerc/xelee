/* XeleeNet's lobby banner over the CSS (src/pc/xeleenet_menu.cpp, wireframe
 * C1): the brand, the lobby's name and rules, its players and its code, in
 * place of Melee's logo and rules bar. Laid out in px at a 72 px height; the
 * code scales #bar to the window. F5 in the game reloads this file. */
* { box-sizing: border-box; }
body { width: 100%; height: 100%; margin: 0; font-family: "Noto Sans"; color: #fff8e0; background-color: #00000000; }
div, span { display: block; }
#bar { position: absolute; left: 0; top: 0; height: 72px; transform-origin: 0 0; }
.brand { position: absolute; left: 0; top: 4px; width: 250px; height: 64px; padding-left: 26px; font-size: 34px;
         font-weight: 800; letter-spacing: 2px; line-height: 62px; color: #ffffff;
         background-color: #c8321e; border-radius: 32px 0 0 32px; }
/* No italic face ships, so the brand leans by a skew. */
.brand span { display: inline-block; transform: skewX(-12deg); }
.pill { position: absolute; left: 236px; right: 0; top: 4px; height: 64px; border: 3px #f0c226; border-radius: 0 32px 32px 0;
        background-color: #120d08f0; }
.names { position: absolute; left: 30px; top: 6px; width: 60%; }
.bn { font-size: 24px; font-weight: 800; color: #ffffff; }
.br { font-size: 15px; color: #c9b77c; }
.seats { position: absolute; right: 250px; top: 14px; font-size: 24px; font-weight: 800; color: #fff8e0; }
.code { position: absolute; right: 18px; top: 11px; height: 36px; padding: 0 16px; font-size: 19px; font-weight: 800;
        letter-spacing: 2px; line-height: 32px; color: #ffe066; border: 2px #f0c226; border-radius: 18px; }
