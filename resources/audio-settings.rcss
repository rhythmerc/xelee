/* Audio (src/pc/audio_menu.cpp): the Controls screen's gold line work
   (fight-controls.rcss), drawn into the native Options page's frame
   (src/melee/mn/mnfight.c) over the running menu. No backdrop, title or
   footer: the page's frame, tab and hint box are Melee's. Laid out in px on
   a 1120x660 screen that the code scales into the frame (#screen's
   transform). */
* { box-sizing: border-box; }
body { width: 100%; height: 100%; margin: 0; font-family: "Noto Sans"; color: #f0f2f5; background-color: #00000000; }
div, span { display: block; }
#screen { position: absolute; left: 0; top: 0; width: 1120px; height: 660px; transform-origin: 0 0; }
#board { position: absolute; left: 0; top: 0; width: 1120px; height: 660px; }

/* A group's heading on its rule, as the stock Sound page's CHANNEL and VOLUME. */
.group { position: absolute; height: 22px; }
.group .rule { position: absolute; left: 0; right: 0; top: 11px; height: 2px; background-color: #f0c22660; }
.group .label { position: absolute; left: 18px; top: 0; padding: 0 10px; font-size: 17px; letter-spacing: 3px; color: #c9b77c; background-color: #0a0906; }

.row { position: absolute; height: 64px; padding: 0 22px; border: 3px #f0c226b0; border-radius: 7px; background-color: #0c0b08e0; box-shadow: #ff961450 0px 0px 8px 1px; }
.row .name { position: absolute; left: 24px; top: 13px; font-size: 26px; font-weight: bold; color: #fff8e0; }
.row.cursor { border-color: #fff4c4; background-color: #1d180af0; box-shadow: #ffb020e0 0px 0px 14px 3px; }
.row.unavailable .name { color: #8d8468; font-weight: normal; }
.row.unavailable { border-color: #f0c22650; box-shadow: none; }

/* A bar of twenty steps and its percent. */
.bar { position: absolute; top: 19px; height: 20px; }
.step { position: absolute; top: 0; width: 16px; height: 20px; border-radius: 2px; background-color: #2a251a; }
.step.on { background-color: #f0c226; box-shadow: #ff961480 0px 0px 5px 1px; }
.row.cursor .step.on { background-color: #fff0a8; box-shadow: #ffb020c0 0px 0px 7px 1px; }
.row.muted .step.on { background-color: #8d7a3c; box-shadow: none; }
.pct { position: absolute; top: 15px; width: 72px; text-align: right; font-size: 23px; color: #f0e4b8; }

/* A switch: Off and On, the one in force lit. */
.choice { position: absolute; top: 13px; width: 96px; height: 32px; padding-top: 2px; text-align: center; font-size: 21px; border-radius: 5px; color: #6f6852; }
.choice.on { color: #1a1406; font-weight: bold; background-color: #f0c226; box-shadow: #ff961480 0px 0px 6px 1px; }
.row.cursor .choice.on { background-color: #fff0a8; box-shadow: #ffb020c0 0px 0px 8px 2px; }
.row.unavailable .choice.on { color: #a49a7c; background-color: #3a3320; box-shadow: none; font-weight: normal; }
.note { position: absolute; top: 20px; font-size: 15px; letter-spacing: 1px; color: #c9b77c; text-align: right; }

#reset { position: absolute; width: 260px; height: 42px; padding-top: 7px; text-align: center; border: 3px #f0c226a0; border-radius: 7px; background-color: #0c0b08e0; font-size: 18px; color: #f0e4b8; }
#reset.cursor { border-color: #fff4c4; color: #ffffff; background-color: #1d180af0; box-shadow: #ffb020e0 0px 0px 14px 3px; }
